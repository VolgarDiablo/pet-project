<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 8px; padding: 40px; }
    .header { background: #4F46E5; color: white; padding: 20px; border-radius: 8px 8px 0 0; text-align: center; }
    .body { padding: 30px 20px; color: #333; }
    .button { display: inline-block; padding: 12px 30px; background: #4F46E5; color: white;
              text-decoration: none; border-radius: 5px; margin-top: 20px; }
    .footer { text-align: center; color: #999; font-size: 12px; margin-top: 30px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Welcome to MyApp!</h1>
    </div>
    <div class="body">
      <h2>Hi {{name}},</h2>
      <p>Thanks for signing up! We're excited to have you on board.</p>
      <p>Click the button below to get veryfied your email:</p>
      <a href="{{veryfiedUrl}}" class="button">Veryfied your email</a>
    </div>
    <div class="footer">
      <p>© 2026 MyApp. All rights reserved.</p>
    </div>
  </div>
</body>
</html>