<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 8px; padding: 40px; }
    .code { font-size: 32px; letter-spacing: 8px; font-weight: bold; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Hi {{name}},</h1>
    <p>Enter this code to confirm your email. It expires in 15 minutes.</p>
    <p class="code">{{code}}</p>
    <p>Or open the verification page: <a href="{{veryfiedUrl}}">{{veryfiedUrl}}</a></p>
  </div>
</body>
</html>
